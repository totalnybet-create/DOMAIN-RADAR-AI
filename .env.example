# Dynadot REST API v2 (server-side only)
DYNADOT_API_KEY=
DYNADOT_API_SECRET=
DYNADOT_CURRENCY=PLN
DYNADOT_BULK_SIZE=5
DYNADOT_REQUEST_INTERVAL_MS=1050
DYNADOT_REGISTRATION_ENABLED=true

# Marża klienta
DYNADOT_MARKUP_PERCENT=20
DYNADOT_MARKUP_FIXED=0

# .pl: awaryjne ceny, gdy bulk_search nie zwróci ceny dla domeny
DYNADOT_PL_REGISTRATION_PRICE=
DYNADOT_PL_RENEWAL_PRICE=
DYNADOT_PL_TRANSFER_PRICE=
DYNADOT_PL_PRICE_CURRENCY=PLN
DYNADOT_USD_PLN_RATE=4

# Opcjonalny token tylko dla administracyjnego endpointu /api/dynadot/register
DOMAIN_RADAR_REGISTRATION_TOKEN=

# HotPay PBL / Przelewy (server-side only)
# Uzupełnić po akceptacji serwisu DomenaGo w panelu HotPay.
HOTPAY_SERVICE_SECRET=
HOTPAY_NOTIFICATION_PASSWORD=

# Stripe Checkout (fallback / opcjonalnie)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

NEXT_PUBLIC_APP_URL=https://domain-radar-ai.vercel.app

# Dynadot REST API v2 (server-side only)
DYNADOT_API_KEY=
DYNADOT_API_SECRET=
DYNADOT_CURRENCY=PLN
DYNADOT_BULK_SIZE=5
DYNADOT_REQUEST_INTERVAL_MS=1050

# Marża klienta
DYNADOT_MARKUP_PERCENT=20
DYNADOT_MARKUP_FIXED=0

# .pl: availability comes from RDAP; prices must be your Dynadot account prices
DYNADOT_PL_REGISTRATION_PRICE=
DYNADOT_PL_RENEWAL_PRICE=
DYNADOT_PL_PRICE_CURRENCY=PLN

DYNADOT_REGISTRATION_ENABLED=false
DOMAIN_RADAR_REGISTRATION_TOKEN=

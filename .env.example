# Optional AI provider. The app works with the deterministic fallback when unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Dynadot REST API v2. Keep credentials server-side only.
DYNADOT_API_KEY=
DYNADOT_API_SECRET=
DYNADOT_CURRENCY=PLN
DYNADOT_BULK_SIZE=5
DYNADOT_REQUEST_INTERVAL_MS=1050

# Working retail pricing rule. Adjust before enabling customer checkout.
DYNADOT_MARKUP_PERCENT=20
DYNADOT_MARKUP_FIXED=0

# Registration remains off until payment/auth is connected.
DYNADOT_REGISTRATION_ENABLED=false
DOMAIN_RADAR_REGISTRATION_TOKEN=
